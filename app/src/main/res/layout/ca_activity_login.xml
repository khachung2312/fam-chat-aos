<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/bg_login"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/ln_language"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/_5sdp"
        app:layout_constraintBottom_toTopOf="@+id/lnInfoUser"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/card_flag"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_20sdp"
            app:cardCornerRadius="@dimen/_2sdp"
            app:cardElevation="0dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_flag"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/ca_ic_flag_vn" />
        </androidx.cardview.widget.CardView>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_language_name"
            style="@style/TextStyleNormal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:ellipsize="end"
            android:singleLine="true"
            tools:text="@string/fc_app_name" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lnInfoUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.20"
        app:layout_constraintVertical_chainStyle="spread"
        app:layout_constraintWidth_percent="0.267">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_logo"
            android:layout_width="@dimen/_86sdp"
            android:layout_height="@dimen/_86sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:scaleType="centerCrop"
            app:srcCompat="@drawable/ca_ic_menu" />

        <LinearLayout
            android:id="@+id/ln_save_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <com.example.famchat.widget.CircleImageView
                android:id="@+id/iv_avatar"
                android:layout_width="@dimen/_65sdp"
                android:layout_height="@dimen/_65sdp"
                android:scaleType="centerCrop"
                android:src="@drawable/ca_ic_menu"
                app:civ_border_color="@color/color_CED4DA"
                app:civ_border_width="1dp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvDocumentNumber"
                style="@style/TextStyleMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackground"
                android:gravity="end"
                android:layout_marginTop="@dimen/_14sdp"
                android:textSize="@dimen/_13sdp"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvChangeAccount"
                style="@style/TextStyleMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackground"
                android:gravity="end"
                android:text="ca_change_account"
                android:textColor="@color/ca_color_primary"
                android:textSize="@dimen/_13sdp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>


    <LinearLayout
        android:id="@+id/ln_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_20sdp"
        app:layout_constraintVertical_bias="0.4"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/lnInfoUser">

        <LinearLayout
            android:id="@+id/lnGuideRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_gravity="end"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_1sdp"
                android:layout_marginEnd="@dimen/_3sdp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/ca_ic_menu"/>

            <TextView
                android:id="@+id/tvGuideRegister"
                style="@style/TextStyleNormal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:textSize="@dimen/_12sdp"
                android:text="@string/fc_app_name"
                android:textColor="@color/ca_color_primary"
                android:drawablePadding="@dimen/_3sdp" />
        </LinearLayout>


        <com.example.famchat.widget.CustomEditText
            android:id="@+id/edt_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_radius_5"
            app:hintForce="@string/fc_app_name"
            app:imeOptions="actionNext" />

        <com.example.famchat.widget.CustomEditText
            android:id="@+id/edt_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/bg_white_radius_5"
            app:hintForce="@string/fc_app_name"
            app:imeOptions="actionDone"
            app:inputType="password" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp">

            <CheckBox
                android:id="@+id/cb_save_account"
                style="@style/TextStyleMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/ca_color_primary"
                android:paddingStart="@dimen/_5sdp"
                android:text="@string/fc_app_name"
                android:textSize="@dimen/_12sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_forgot_password"
                style="@style/TextStyleMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackground"
                android:gravity="end"
                android:padding="@dimen/_5sdp"
                android:paddingVertical="@dimen/_3sdp"
                android:text="@string/fc_app_name"
                android:textColor="@color/ca_color_primary"
                android:textSize="@dimen/_13sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.example.famchat.widget.LibUIButtonCustom
                android:id="@+id/btn_login"
                style="@style/TextStyleNormal"
                android:layout_width="0dp"
                android:layout_height="@dimen/_35sdp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:layout_weight="1"
                android:text="@string/fc_app_name"
                app:button_type="disable" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_fingerprint"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/_3sdp"
                app:srcCompat="@drawable/ca_ic_menu" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_register_account"
            style="@style/TextStyleMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/_5sdp"
            android:background="?attr/selectableItemBackground"
            android:gravity="end"
            android:padding="@dimen/_5sdp"
            android:paddingVertical="@dimen/_3sdp"
            android:text="@string/fc_app_name"
            android:textColor="@color/ca_color_primary"
            android:textSize="@dimen/_13sdp" />

        <TextView
            android:id="@+id/tvOr"
            style="@style/TextStyleNormal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="@dimen/_6sdp"
            android:textColor="@color/color_121517"
            android:textSize="@dimen/_12sdp"
            android:text="@string/fc_app_name"/>


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>