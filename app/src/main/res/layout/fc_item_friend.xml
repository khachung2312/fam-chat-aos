<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/_8sdp">

    <FrameLayout
        android:id="@+id/frameBorder"
        android:layout_width="@dimen/_60sdp"
        android:layout_height="@dimen/_60sdp"
        android:layout_gravity="center"
        android:background="@drawable/fc_bg_friend_border_unseen"
        android:padding="@dimen/_3sdp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/user_img"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.App.CircleImageView" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imgAddIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="bottom|end"
            android:src="@drawable/fc_ic_plus"
            android:background="@drawable/fc_bg_radius_white_50sdp"
            android:padding="2dp"
            android:elevation="2dp"
            android:visibility="gone" /> </FrameLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4sdp"
        android:textColor="@color/white"
        android:textSize="@dimen/_12ssp"
        android:ellipsize="end"
        android:singleLine="true"
        android:maxWidth="@dimen/_72sdp"
        android:gravity="center"
        android:text="Friend name" />
</LinearLayout>