<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:paddingTop="@dimen/_5sdp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/text_input_layout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/_10sdp"
        app:hintTextColor="@color/color_6C757D"
        app:layout_constraintEnd_toStartOf="@+id/iv_clear"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edt_input"
            style="@style/TextStyleNormal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:ellipsize="end"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:maxLength="200"
            android:paddingTop="@dimen/_5sdp"
            android:paddingBottom="@dimen/_5sdp"
            android:singleLine="true"
            android:textColorHint="@color/color_6C757D" />

    </com.google.android.material.textfield.TextInputLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_clear"
        android:layout_width="@dimen/_25sdp"
        android:layout_height="@dimen/_25sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_3sdp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/_4sdp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@+id/iv_password"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ca_ic_close_round" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_password"
        android:layout_width="@dimen/_25sdp"
        android:layout_height="@dimen/_25sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_3sdp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/_4sdp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@+id/tv_end"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ca_ic_show_pass" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_end"
        android:layout_width="@dimen/_25sdp"
        android:layout_height="@dimen/_25sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_3sdp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/_4sdp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_end"
        style="@style/TextStyleNormal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginEnd="@dimen/_3sdp"
        android:background="?attr/selectableItemBackground"
        android:padding="@dimen/_3sdp"
        android:textColor="@color/fc_color_primary"
        android:textSize="@dimen/_12sdp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@+id/iv_end"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="@string/fc_app_name" />

    <View
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.4"
        android:background="@color/color_ADB5BD"
        app:layout_constraintTop_toBottomOf="@+id/text_input_layout" />

    <FrameLayout
        android:id="@+id/frm_click"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/text_input_layout"
        app:layout_constraintTop_toTopOf="@+id/text_input_layout" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_error"
        style="@style/TextStyleNormal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/_3sdp"
        android:clickable="false"
        android:text="@string/fc_app_name"
        android:textColor="@color/fc_color_primary"
        android:textSize="@dimen/_10sdp"
        android:textStyle="italic"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_end"
        app:layout_constraintTop_toBottomOf="@+id/text_input_layout" />
</androidx.constraintlayout.widget.ConstraintLayout>