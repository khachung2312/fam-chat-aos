<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Background -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/bg_login"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <!-- Back button -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_back"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:srcCompat="@drawable/fc_ic_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="@dimen/_16sdp" />

    <com.example.famchat.widget.LayoutLanguageThemes
        android:id="@+id/layout_language_themes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_16sdp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/_5sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- Title + Subtitle -->
    <LinearLayout
        android:id="@+id/ln_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_50sdp"
        app:layout_constraintTop_toBottomOf="@+id/iv_back">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_login_title"
            style="@style/TextStyleMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fc_sign_up_mail"
            android:textSize="@dimen/_18sdp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/black" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_login_subtitle"
            style="@style/TextStyleNormal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="@dimen/_6sdp"
            android:text="@string/fc_get_chatting"
            android:textSize="@dimen/_13sdp"
            />
    </LinearLayout>

    <!-- Login form -->
    <LinearLayout
        android:id="@+id/ln_login"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/ln_title"
        app:layout_constraintBottom_toTopOf="@+id/layout_bottom">


        <!-- Username -->
        <com.example.famchat.widget.CustomEditText
            android:id="@+id/edt_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_radius_5"
            app:hintForce="@string/fc_your_name"
            android:layout_marginVertical="@dimen/_10sdp"
            app:imeOptions="actionNext" />

        <com.example.famchat.widget.CustomEditText
            android:id="@+id/edt_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_radius_5"
            app:hintForce="@string/fc_your_email"
            android:layout_marginVertical="@dimen/_10sdp"
            app:imeOptions="actionNext" />

        <!-- Password -->
        <com.example.famchat.widget.CustomEditText
            android:id="@+id/edt_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/_10sdp"
            android:background="@drawable/bg_white_radius_5"
            app:hintForce="@string/fc_password"
            app:imeOptions="actionDone"
            app:inputType="password"
            app:endIcon="@drawable/fc_ic_eye" />

        <com.example.famchat.widget.CustomEditText
            android:id="@+id/edt_confirm_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/_10sdp"
            android:background="@drawable/bg_white_radius_5"
            app:hintForce="@string/fc_confirm_password"
            app:imeOptions="actionDone"
            app:inputType="password"
            app:endIcon="@drawable/fc_ic_eye" />


    </LinearLayout>

    <!-- Bottom actions -->
    <LinearLayout
        android:id="@+id/layout_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="@dimen/_20sdp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Login button -->
        <com.example.famchat.widget.LibUIButtonCustom
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:text="@string/fc_login"
            app:button_type="primary" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
