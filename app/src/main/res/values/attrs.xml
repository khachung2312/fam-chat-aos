<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="LibLibUIButtonCustom">
        <attr name="button_type">
            <enum name="disable" value="0" />
            <enum name="primary" value="1" />
            <enum name="white" value="2" />
            <enum name="blue" value="3" />
            <enum name="strokePrimary" value="4" />
            <enum name="strokeDisable" value="5" />
            <enum name="strokeBlack" value="6" />
            <enum name="grayPrimary" value="7" />
            <enum name="disableRadius" value="8" />
            <enum name="primaryRadius" value="9" />
            <enum name="disableRadiusGray" value="10" />
        </attr>
        <attr name="pb_cornerRadius" format="dimension" />
        <attr name="pb_isUseCustomFont" format="boolean" />
    </declare-styleable>

    <declare-styleable name="LayoutLogoAndDescription">
        <attr name="iv_logo" format="reference"/>
        <attr name="textTitle" format="string" />
        <attr name="textDescription" format="string" />
    </declare-styleable>

    <attr name="colorBgItem" format="color|reference|dimension|string|boolean" />
    <attr name="buttonPrimary" format="reference"/>
    <attr name="buttonGrayPrimary" format="reference"/>
    <attr name="colorTextPrimary" format="color"/>
    <attr name="bgEdtChat" format="reference"/>

    <declare-styleable name="CustomEditText">
        <attr name="hint" format="string" />
        <attr name="hintForce" format="string" />
        <attr name="inputDate" format="boolean" />
        <attr name="maxLength" format="integer" />
        <attr name="endText" format="string" />
        <attr name="label" format="string" />
        <attr name="labelForce" format="string" />
        <attr name="enable" format="boolean" />
        <attr name="showClearButton" format="boolean" />
        <attr name="clickViewEnable" format="boolean" />
        <attr name="multiLine" format="boolean" />
        <attr name="endIcon" format="reference|color" />
        <attr name="startIcon" format="reference|color" />
        <attr name="inputType" format="string">
            <enum name="text" value="0" />
            <enum name="number" value="1" />
            <enum name="password" value="2" />
            <enum name="money" value="3" />
        </attr>
        <attr name="textStyle" format="string">
            <enum name="TextStyleNormal" value="0" />
            <enum name="TextStyleMedium" value="1" />
            <enum name="TextStyleBold" value="2" />
        </attr>
        <attr name="imeOptions" format="string">
            <enum name="actionNext" value="0" />
            <enum name="actionDone" value="1" />
        </attr>
        <attr name="textColor" format="color" />
        <attr name="importantForAutofill" format="integer">
            <flag name="auto" value="0" />
            <flag name="yes" value="0x1" />
            <flag name="no" value="0x2" />
            <flag name="yesExcludeDescendants" value="0x4" />
            <flag name="noExcludeDescendants" value="0x8" />
        </attr>

    </declare-styleable>

    <declare-styleable name="CustomToolbar">
        <attr name="title" format="string" />
        <attr name="iconRight" format="reference|color" />
    </declare-styleable>

    <declare-styleable name="CustomItemNavigation">
        <attr name="navIcon" format="reference|color" />
        <attr name="rightIcon" format="reference|color" />
        <attr name="navName" format="string" />
        <attr name="isHideLineBottom" format="boolean" />
    </declare-styleable>

    <declare-styleable name="CustomLayoutNoData">
        <attr name="description" format="string" />
        <attr name="src" format="reference|color" />
    </declare-styleable>

    <declare-styleable name="ViewFinderBackground">
        <attr name="backgroundColor" format="color" />
    </declare-styleable>

    <declare-styleable name="CircleImageView">
        <attr name="civ_border_width" format="dimension" />
        <attr name="civ_border_color" format="color" />
        <attr name="civ_border_overlay" format="boolean" />
        <attr name="civ_circle_background_color" format="color" />
    </declare-styleable>

    <declare-styleable name="RoundedImageView">
        <attr name="riv_corner_radius" format="dimension" />
        <attr name="riv_corner_radius_top_left" format="dimension" />
        <attr name="riv_corner_radius_top_right" format="dimension" />
        <attr name="riv_corner_radius_bottom_left" format="dimension" />
        <attr name="riv_corner_radius_bottom_right" format="dimension" />
        <attr name="riv_border_width" format="dimension" />
        <attr name="riv_border_color" format="color" />
        <attr name="riv_mutate_background" format="boolean" />
        <attr name="riv_oval" format="boolean" />
        <attr name="android:scaleType" />
        <attr name="riv_tile_mode">
            <enum name="clamp" value="0" />
            <enum name="repeat" value="1" />
            <enum name="mirror" value="2" />
        </attr>
        <attr name="riv_tile_mode_x">
            <enum name="clamp" value="0" />
            <enum name="repeat" value="1" />
            <enum name="mirror" value="2" />
        </attr>
        <attr name="riv_tile_mode_y">
            <enum name="clamp" value="0" />
            <enum name="repeat" value="1" />
            <enum name="mirror" value="2" />
        </attr>
    </declare-styleable>

    <declare-styleable name="StickerView">
        <attr name="showIcons" format="boolean" />
        <attr name="showBorder" format="boolean" />
        <attr name="bringToFrontCurrentSticker" format="boolean" />
        <attr name="borderColorSticker" format="color" />
        <attr name="borderAlphaSticker" format="integer" />
    </declare-styleable>

    <declare-styleable name="SilkySignaturePad">
        <attr name="penMinWidth" format="dimension" />
        <attr name="penMaxWidth" format="dimension" />
        <attr name="penColor" format="color" />
        <attr name="velocityFilterWeight" format="float" />
        <attr name="clearOnDoubleClick" format="boolean" />
    </declare-styleable>

    <declare-styleable name="LoopView">
        <attr name="awv_textsize" format="integer" />
        <attr name="awv_lineSpace" format="float" />
        <attr name="awv_centerTextColor" format="integer" />
        <attr name="awv_outerTextColor" format="integer" />
        <attr name="awv_dividerTextColor" format="integer" />
        <attr name="awv_itemsVisibleCount" format="integer" />
        <attr name="awv_isLoop" format="boolean" />
        <attr name="awv_isCurve" format="boolean" />
        <attr name="awv_initialPosition" format="integer" />
        <attr name="awv_scaleX" format="float" />
    </declare-styleable>

    <declare-styleable name="SwipeRevealLayout">
        <attr name="dragEdge">
            <flag name="left" value="1" />
            <flag name="right" value="2" />
            <flag name="top" value="4" />
            <flag name="bottom" value="8" />
        </attr>

        <attr name="mode">
            <enum name="normal" value="0" />
            <enum name="same_level"   value="1" />
        </attr>

        <attr name="flingVelocity" format="integer" />

        <attr name="minDistRequestDisallowParent" format="dimension" />
    </declare-styleable>

</resources>