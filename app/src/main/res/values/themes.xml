<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.BaseAndroid" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/fc_color_primary</item>
        <item name="colorPrimaryDark">@color/fc_color_primary_dark</item>
        <item name="colorAccent">@color/color_accent</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:fitsSystemWindows">true</item>

        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowAnimationStyle">@style/WindowTransition</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="colorControlHighlight">@color/ca_color_primary_highlight</item>
        <item name="colorControlNormal">@color/color_ADB5BD</item>
    </style>
    <style name="ImageViewStyle1">
        <item name="android:src">@drawable/fc_ic_menu</item>
    </style>
    <style name="ShapeAppearance.App.CircleImageView" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="WindowTransition">
        <item name="android:activityOpenEnterAnimation">@anim/pull_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/push_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/pull_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/push_out_right</item>
    </style>

    <style name="NavigationDrawerStyle">
        <item name="android:textSize">@dimen/_13sdp</item>
        <item name="android:textColor">@color/color_text_default</item>
        <item name="android:fontFamily">@font/sp_pro_display_regular</item>
    </style>

    <style name="TextStyleBold" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">@dimen/_14sdp</item>
        <item name="android:textColor">@color/color_text_default</item>
        <item name="android:fontFamily">@font/sf_pro_display_bold</item>
    </style>

    <style name="TextStyleNormal" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">@dimen/_14sdp</item>
        <item name="android:textColor">@color/color_text_status_default</item>
        <item name="android:fontFamily">@font/sp_pro_display_regular</item>
    </style>

    <style name="TextStyleMedium" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">@dimen/_14sdp</item>
        <item name="android:textColor">@color/color_text_status_default</item>
        <item name="android:fontFamily">@font/sf_pro_display_medium</item>
    </style>

    <style name="customTabLayout" parent="@android:style/TextAppearance.Small">
        <item name="android:fontFamily">@font/sf_pro_display_medium</item>
        <item name="android:textSize">@dimen/_12sdp</item>
        <item name="android:textColor">@color/color_text_status_default</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="PopupMenuStyle" parent="Widget.AppCompat.PopupMenu">
        <item name="android:textColor">@color/color_text_status_default</item>
        <item name="android:fontFamily">@font/sp_pro_display_regular</item>
        <item name="android:textSize">@dimen/_11sdp</item>
        <item name="android:popupBackground">@drawable/bg_white_radius_5</item>
    </style>

    <style name="DialogStyle" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="BottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/bottomSheetStyleWrapper</item>
    </style>

    <style name="bottomSheetStyleWrapper" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="NestedScrollBarStyle">
        <item name="android:scrollbarFadeDuration">2</item>
        <item name="android:scrollbars">vertical</item>
        <item name="android:fillViewport">true</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="roundedCornersBottom" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeBottomLeft">8dp</item>
        <item name="cornerSizeBottomRight">8dp</item>
    </style>

</resources>